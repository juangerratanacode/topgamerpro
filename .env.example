# ==========================================================
# Copia este archivo como .env.local y llena los valores reales.
# NUNCA subas .env.local a git (ya está en .gitignore).
# ==========================================================

# --- Supabase (se llenan en el siguiente paso, todavía no) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Reloadly (solo para productos de gift cards) ---
# Genera llaves NUEVAS en el panel de Reloadly, las viejas quedaron
# expuestas en el export de WordPress y no deben reutilizarse.
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=

# --- WhatsApp de atención (formato internacional, con +) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=+584123542332

# --- Resend (correos transaccionales) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=pedidos@tudominio.com

# --- Datos bancarios para mostrar en checkout ---
PAGO_MOVIL_BANCO="Banesco (0134)"
PAGO_MOVIL_TELEFONO="0412-3542332"
PAGO_MOVIL_CEDULA="V-27894619"
BINANCE_CUENTA="tu-correo@binance.com"
